# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
APP_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# Database
DATABASE_URL=sqlite:///./adblocker.db

# Filter List URLs
EASYLIST_URL=https://easylist.to/easylist/easylist.txt
EASYPRIVACY_URL=https://easylist.to/easylist/easyprivacy.txt
UBLOCK_URL=https://raw.githubusercontent.com/uBlockOrigin/uAssets/master/filters/filters.txt

# Update Interval (hours)
FILTER_UPDATE_INTERVAL=24

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# ML Engine
ML_MODEL_PATH=./ml_engine/data/model.joblib
ML_TRAINING_DATA=./ml_engine/data/training_data.csv
ML_CONFIDENCE_THRESHOLD=0.75

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/adblocker.log

# CORS (browser extension origins)
CORS_ORIGINS=chrome-extension://,moz-extension://,ms-browser-extension://
